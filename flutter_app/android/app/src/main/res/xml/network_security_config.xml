<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">runasp.net</domain>
        <domain includeSubdomains="true">islamicsppapi.runasp.net</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">ip-api.com</domain>
        <domain includeSubdomains="true">ipapi.co</domain>
    </domain-config>
</network-security-config>

